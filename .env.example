# ────────────────────────────────────────────────────────────────────
# NYC Transit Predictor — Environment Configuration
# Copy to .env and fill in your values. .env is gitignored.
# ────────────────────────────────────────────────────────────────────

# ── Spark Configuration ─────────────────────────────────────────────
SPARK_APP_NAME=NYCTransitPredictor
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8

# ── Paths ───────────────────────────────────────────────────────────
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
MODEL_DIR=models
PLOTS_DIR=dashboard/static/plots
LOG_DIR=logs

# ── Model Hyperparameters ───────────────────────────────────────────
RF_NUM_TREES=100
RF_MAX_DEPTH=10
RF_MAX_BINS=64
TEST_SIZE=0.2
RANDOM_SEED=42

# ── Streamlit ───────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Weather API (optional, future feature) ──────────────────────────
WEATHER_API_KEY=
WEATHER_CITY=New York
